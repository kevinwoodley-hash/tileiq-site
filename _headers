/.well-known/assetlinks.json
  Content-Type: application/json

# iOS Universal Links: Apple fetches this extensionless file and needs it served as JSON
/.well-known/apple-app-site-association
  Content-Type: application/json

/guides-src/*
  X-Robots-Tag: noindex

# Private screens: keep out of search results (Oct 2026)
/admin
  X-Robots-Tag: noindex, nofollow

/admin/*
  X-Robots-Tag: noindex, nofollow

/enquire
  X-Robots-Tag: noindex

/enquire/*
  X-Robots-Tag: noindex
